# LockSense — Servicio de reconocimiento facial (ejemplo de configuración).
#
# Copia este archivo como `.env` y completa los valores reales.
# NO comitees un `.env` con secretos. Este archivo solo documenta las variables.

# Clave compartida entre Laravel (header X-API-Key) y este servicio.
# OBLIGATORIA: si no está definida, el servicio NO atiende peticiones de
# reconocimiento (falla de forma segura, sin autenticar a nadie).
# Debe coincidir con FACE_SERVICE_API_KEY del backend Laravel.
# Genera una cadena larga y aleatoria; no uses este valor de ejemplo.
FACE_SERVICE_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Nombre del pack de modelos de InsightFace a cargar. Por defecto: buffalo_l.
FACE_SERVICE_MODEL=buffalo_l

# Tamaño máximo de imagen aceptado, en bytes. Por defecto: 8388608 (8 MB).
# Se valida sobre los bytes realmente leídos, no sobre el header HTTP.
FACE_SERVICE_MAX_IMAGE_BYTES=8388608
